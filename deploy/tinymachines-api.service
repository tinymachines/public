# tinymachines.ai/api: FastAPI on 127.0.0.1:6510, behind nginx.
#
# --root-path /api is not cosmetic. nginx proxies with a trailing slash, so
# /api/v1/pieces arrives here as /v1/pieces and uvicorn would otherwise
# generate a document describing paths no client can call. With it, the
# servers block and every generated URL carry the prefix the caller uses.
#
# NOT 6502. 127.0.0.1:6502 is the live 6502 API. A uvicorn started on a port
# that is already held fails to bind, and every request then goes to
# production while looking local. That has already happened once here.
#
# The interpreter is named by absolute path for the reason the web unit names
# bun by absolute path: systemd's PATH is /usr/local/sbin:...:/snap/bin and
# nothing else, so "whatever the shell finds" is not what this unit finds.
#
# Loopback only. nginx reaches it on 127.0.0.1 and this box serves many other
# vhosts; there is no reason for this port to be reachable from outside.
#
# Install:
#   sudo cp deploy/tinymachines-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tinymachines-api
#
# Unlike the web unit, this needs no build step: it reads its own source. But
# it holds the six pieces in memory, so a change to api/ needs a restart.
#
# It now also holds state. StateDirectory below creates /var/lib/tinymachines,
# owned by this user, and systemd exports it as $STATE_DIRECTORY; api/db.py
# resolves the database to $STATE_DIRECTORY/roof.db when TM_DB is not set. The
# path is therefore never typed anywhere: not in this file, not in the code.
#
# It lives outside the checkout on purpose. A database inside the working tree
# survives exactly until somebody moves the clone, and is one `git clean` away
# from being gone. Set TM_DB to override for a one-off run.
#
# Reinstalling this file needs a daemon-reload, which deploy.sh does NOT do:
#   sudo cp deploy/tinymachines-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart tinymachines-api

[Unit]
Description=tinymachines.ai API (FastAPI, REST and MCP)
After=network.target

[Service]
Type=simple
User=bisenbek
WorkingDirectory=/home/bisenbek/projects/tinymachines/public
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# The state directory, and the mode it is created with. 0700 rather than the
# 0755 default because what is in there is credential digests and people's
# addresses, and this box serves about forty other vhosts: "only readable by
# the user that owns it" should be a property of the directory rather than of
# nobody having looked. UMask makes the database file itself match, since a
# 0600 file in a 0700 directory is the pair that has to hold.
StateDirectory=tinymachines
StateDirectoryMode=0700
UMask=0077

# The public token mint (api/mint.py) mints the chip API's registry tokens by
# calling the registry's own code against the registry's own file. Both are
# named here and nowhere else: without them the mint declares itself off and
# everything else serves, which is what a checkout on any other box gets.
# The file is the 6502 unit's REGISTRY_DB; the code is the 6502 checkout's
# service directory. Both services run as this user, which is what makes
# this a file open rather than a second credential.
Environment=TM_REGISTRY_DB=/var/lib/6502-registry/registry.db
Environment=TM_REGISTRY_SERVICE=/home/bisenbek/projects/tinymachines/6502/service

# Modest hardening, added when this service stopped being stateless. Each line
# is here because it costs nothing that this service does: it reads its own
# source and .git, writes only to StateDirectory, and makes outbound HTTPS
# requests from the prober.
#
# ProtectSystem=full, not strict: strict would make the checkout read-only
# too, which is correct today and would turn the next legitimate write into a
# confusing permissions error rather than a decision. full covers /usr, /boot
# and /etc, which is where an escalation would want to land.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ExecStart=/usr/bin/python3 -m uvicorn app:app --app-dir api --host 127.0.0.1 --port 6510 --root-path /api
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
