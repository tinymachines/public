# tinymachines.ai and www -- the apex, the docs tree and the API.
#
# INSTALLED 2026-08-22, as sites-available/tinymachines.ai.apex.nginx with a
# symlink from sites-enabled. This is the source of truth; the copy under
# /etc/nginx is a copy. Change it here, then reinstall, `nginx -t`, reload.
#
# The apex used to live in the first two server blocks of the shared
# tinymachines.ai.nginx, behind a PIN gate and reverse-proxying to GitHub.
# Those blocks were removed when this went in, which is what dropped the gate.
#
# Two processes behind it, both on loopback and both built from source:
#   127.0.0.1:6511  Next 16, serving / and /docs
#   127.0.0.1:6510  uvicorn, serving /api
#
# Cache policy lives in a map rather than in per-location `add_header`, and
# that is load-bearing rather than stylistic: nginx's add_header does not merge
# across levels, so a location containing ANY add_header discards every
# inherited one. The 6502 vhost lost its CSP and HSTS that way once. With the
# value in a variable, every header is declared once at server level and no
# location needs add_header at all.

# A second map, on status rather than path, because the first one cannot see
# whether the response succeeded.
#
# This exists because of a measured bug. /_next/static/ is marked immutable
# for a year, which is right for a content-hashed asset and catastrophic for a
# 404: `next start` serves only the CURRENT build's chunks, so every rebuild
# deletes the previous hashes. A browser that asked for a chunk during a
# deploy got a 404 carrying "public, max-age=31536000, immutable" and cached
# THAT for a year. The symptom is a page with no stylesheet at all, which
# looks like the design was never applied rather than like a caching fault.
#
# add_header skips a header whose final value is empty, so exactly one of this
# and the map below ever produces a value.
map $status $tmapex_error_cache {
    default    "";
    "~^[45]"   "no-store";
}

map $uri $tmapex_cache {
    # Quoted: nginx parses a bare { in a map key as the start of a block.
    #
    # /api/ maps to the empty string on purpose. add_header skips a header
    # whose final value is empty, so this is how nginx declines to have an
    # opinion and lets the API speak for its own responses. Measured, not
    # assumed: with "" here, the /api/ response carries no nginx
    # Cache-Control at all.
    "~^/api/"                                                  "";
    # The service worker, and it must not be held. sw.js falls to the *.js
    # rule below and was served "public, max-age=31536000"'s smaller cousin,
    # an hour, which is an hour of a returning visitor running the previous
    # deploy's worker. A browser installs a new worker only when the file's
    # BYTES change, and it will not see new bytes it is not allowed to fetch.
    #
    # The registration already passes updateViaCache: "none", which fixes it
    # in the browser. This fixes it at the origin, which is where it belongs:
    # the client-side flag is one line in one app, and anything else that ever
    # fetches /sw.js gets the right answer from the server instead.
    "~^/sw\.js$"                                               "no-store";
    "~^/_next/static/"                                         "public, max-age=31536000, immutable";
    # Next's image optimiser. Safe to treat like a hashed asset even though it
    # is a route with a query string: the source it points at is already
    # content-hashed by the build, and the width and quality are in the query,
    # so a given URL can only ever produce the same bytes.
    #
    # Without this it fell to the default and every page view revalidated the
    # mark, because location / hides the upstream Cache-Control and this map
    # keys on $uri, which does not include the query.
    "~^/_next/image"                                           "public, max-age=31536000, immutable";
    "~*\.(css|js|woff2?|png|jpg|svg|ico)$"                     "public, max-age=3600";
    # The link cards. Rendered on demand from the page's own words, which
    # change with a deploy, so an hour, like any other image here.
    "~^/og(/|$)"                                                "public, max-age=3600";
    default                                                    "no-cache";
}

server {
    include snippets/scanner-trap.conf;
    server_name tinymachines.ai www.tinymachines.ai;
    listen 80;
    listen [::]:80;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    include snippets/scanner-trap.conf;
    server_name tinymachines.ai www.tinymachines.ai;

    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    # The existing certificate is for www.tinymachines.ai. It covers the apex
    # only if the apex name is on it; check before enabling, and extend with
    #   certbot certonly --webroot -w /var/www/html \
    #     -d tinymachines.ai -d www.tinymachines.ai
    # if it is not. A cert that does not cover the apex fails in the browser,
    # not at reload, so `nginx -t` will not catch it.
    ssl_certificate     /etc/letsencrypt/live/www.tinymachines.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.tinymachines.ai/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Its own access log, in the box's `realip` format (nginx.conf defines
    # it: the same fields as combined). Without this line the apex logged to
    # nginx's default access.log with every other unlogged vhost on the box,
    # and scripts/visitors-collect.py had nothing of this site's to count.
    # The subdomains have had theirs all along.
    access_log /var/log/nginx/tinymachines.ai.access.log realip;
    error_log  /var/log/nginx/tinymachines.ai.error.log;

    # connect-src allows the three live subdomains on purpose. They stay where
    # they are for now, so a fetch from here to 6502.tinymachines.ai is
    # cross-origin today; the 6502 API sends Access-Control-Allow-Origin: *
    # for exactly that reason. Narrow this at the move, not before.
    #
    # script-src carries 'unsafe-inline' and it is not decoration. Next's app
    # router inlines the RSC payload as two <script> tags of
    # self.__next_f.push(...) on every page. Without them React never
    # hydrates, and the failure is the quiet kind this repo keeps a list of:
    # the HTML is prerendered, so the page LOOKS right and only stops
    # behaving. Counted on the built output, not assumed: 2 inline scripts,
    # every page.
    #
    # The way to remove it is a per-request nonce from Next middleware, which
    # costs static rendering, since middleware makes every response dynamic.
    # That is a trade to make deliberately when there is something dynamic
    # here, not while the site is nine prerendered documents.
    #
    # style-src carries 'unsafe-inline' too, and it did not at first. That was
    # measured and correct when it was written: the app then had zero inline
    # <style> elements and zero style="" attributes. Then /style/zoo shipped,
    # and the widget zoo is built out of inline style: 73 style attributes on
    # the specimens, one <style> block of its own chrome, and a script that
    # writes element.style.transform to drive the sliders. Every one of them
    # was blocked.
    #
    # The failure is the quiet kind again. Nothing 404s and the page is not
    # blank: the kit's classes still apply, so the buttons and the type look
    # right and only the LAYOUT is missing. It reads as a half-finished design
    # rather than as a policy blocking a stylesheet, and it was reported that
    # way.
    #
    # Scoping the relaxation to the one route was tried on paper and does not
    # work. Next's app router navigates on the client, so a reader who lands
    # on /style and clicks through to /style/zoo is still governed by the
    # document CSP of /style. A per-location header would apply only to
    # readers who load the zoo cold, which is the worse kind of fix: it works
    # when you test it and not when somebody uses the site.
    #
    # What this costs is bounded. There is no user input rendered into any
    # page here: every page is prerendered from files in the repository, so
    # there is no injection vector for a style to arrive through. font-src
    # stays 'self', and the fonts are vendored into the repo, so nothing
    # reaches the network at all.
    #
    # 'wasm-unsafe-eval' is here for the explorer, and it is narrower than it
    # sounds. It permits WebAssembly compilation and nothing else: it does not
    # restore eval(), new Function(), or any of what 'unsafe-eval' allows. The
    # 6502 vhost has carried it for the same reason since that page shipped,
    # and without it the explorer's chip module fails to instantiate with a
    # console error and a blank canvas, which reads as a broken renderer.
    #
    # worker-src is stated rather than inherited. The site registers a service
    # worker, and with the directive absent a worker falls back through
    # child-src to script-src, which carries 'unsafe-inline' for the reason
    # above. Inheriting that would mean the day script-src is loosened for a
    # page, it is loosened for the worker too, silently. This is the one place
    # where naming a directive costs nothing and not naming it couples two
    # decisions that have no reason to be coupled.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://6502.tinymachines.ai https://games.tinymachines.ai https://halfwave.tinymachines.ai https://hotbits.tinymachines.ai; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # No `always` on this one, deliberately. Without it nginx applies the
    # header only to 2xx and 3xx, which is precisely the set that should be
    # cacheable. The error case is handled by the line below instead.
    add_header Cache-Control $tmapex_cache;
    add_header Cache-Control $tmapex_error_cache always;

    # ---------------------------------------------------------------------
    # The 6502 explorer and its archive, served from where they already live.
    #
    # Both are on this box already, published by 6502.tinymachines.ai out of
    # /var/www/6502.tinymachines.ai. These two locations serve the SAME FILES
    # under the apex rather than copying them, and that is a licensing
    # decision rather than an optimisation.
    #
    # The explorer's data is die geometry traced from photographs and the
    # measured tables built from it: layout.bin, the JSON graphs, and a wasm
    # bundle that embeds netlist.bin. All of it is CC BY-NC-SA 3.0. NOTICE.md
    # records that extern/visual6502 is a submodule in the 6502 repo precisely
    # so that repository does not redistribute NC-SA data, and copying 1.5 MB
    # of it into tinymachines/public would undo that by accident, which is how
    # it would happen. An alias is not a second copy: it is one publisher
    # serving one set of bytes at a second address it also owns.
    #
    # /6502/chip/ carries the modules and the stylesheet, which are ours and
    # MIT, and it is where a page loads them from.
    location /6502/chip/ {
        alias /var/www/6502.tinymachines.ai/current/;
        # Their build writes a .gz beside every file and their vhost serves it.
        # Without this the same bytes go out uncompressed from here, which is
        # the sort of difference nobody notices and everybody pays for.
        gzip_static on;
    }

    # The data files, at the paths the explorer's own code asks for.
    #
    # It fetches them DOCUMENT-relative: the deployed app.js says
    # fetch('layout.334bf277.bin'), so from a page at /6502/explorer that
    # resolves to /6502/layout.334bf277.bin. Serving them there means nothing
    # in their code has to be patched, and nothing here has to know a hash:
    # the script asks for whatever name it was built with, and this hands back
    # whatever is in current/. Their deploy and ours stay independent.
    #
    # Narrow on purpose. Only these extensions, only one optional pkg/
    # segment, so it cannot shadow /6502/games or /6502/lab, which are pages
    # and carry no dot.
    # And under /ja/6502/ as well: the Japanese edition of every explorer page
    # is the same document one segment deeper, and their modules resolve
    # their data against the document, so from /ja/6502/tracer the fetch for
    # schematic.json asked for /ja/6502/schematic.json and got a 404 that
    # read as "Could not start". Same files, one more address they answer at.
    location ~ "^/(?:ja/)?6502/(?<chipasset>(?:pkg/)?[A-Za-z0-9._-]+\.(?:bin|json|wasm))$" {
        alias /var/www/6502.tinymachines.ai/current/$chipasset;
    }

    # The archive: 174 MB of visual6502.org recovered from the Wayback
    # Machine. Same reasoning, more so. It is somebody else's site.
    # The overview is ours and is a page on this site; everything below it is
    # the preservation. An exact-match location, so it wins over the prefix one
    # underneath and hands that single path back to Next, while
    # /6502/archive/wiki/... and the rest still come off disk.
    location = /6502/archive/ {
        return 301 /6502/archive;
    }

    location /6502/archive/ {
        alias /var/www/6502.tinymachines.ai/archive/;

        # Its navigation is absolute and rooted at the 6502 site: every page
        # links to /programs, /primer, /trace and /schematic, and a CTA to /.
        # Served here those become /programs on the apex, which does not exist,
        # so all four 404 and the archive arrives with its nav broken. Measured
        # on wiki, gallery and mirror alike: four such links on every page.
        #
        # Rewritten on the way out rather than in the files, because the files
        # are a preservation of somebody else's site and this repository does
        # not edit them. The simulator pages have not moved, so the links point
        # at where they still are; the CTA points at the explorer, which has.
        #
        # gzip_static goes off here for a reason that would otherwise be
        # mysterious: sub_filter cannot rewrite a response nginx did not build,
        # and a precompressed .gz is handed back untouched. On-the-fly gzip
        # still applies. It costs CPU on 8 KB of HTML and buys a nav that works.
        gzip_static off;
        sub_filter_once off;
        sub_filter 'href="/programs"'  'href="/6502/programs"';
        sub_filter 'href="/primer"'    'href="/6502/primer"';
        sub_filter 'href="/trace"'     'href="/6502/trace"';
        sub_filter 'href="/schematic"' 'href="/6502/schematic"';
        sub_filter 'class="nav-cta" href="/"' 'class="nav-cta" href="/6502/explorer"';
    }

    # The 6502 API, mounted under the apex. Settled 2026-08-24 (PROJECTS.md
    # item 4): the service stays one process on 127.0.0.1:6502 and gains this
    # as a second front door; canonical flips to the apex later, as a redirect.
    #
    # X-Forwarded-Prefix is the part that makes the second door honest. The
    # service used to publish servers: [{"url": "/api"}] everywhere, which at
    # this path would send a schema-reading client to the roof's own API
    # below. It now names, per request, the door the request came through;
    # the subdomains send no prefix and fall back to the unit's --root-path.
    #
    # The exact match below is what keeps the reference page: a proxied
    # prefix location makes nginx answer the slash-less form with an
    # automatic 301 onto the prefix, which would land /6502/api on the
    # service's own page instead of this site's reference. Measured, not
    # deduced: the first install of this block did exactly that. Same
    # exact-beats-prefix arrangement the archive uses.
    # The chip-asset regex above cannot shadow either location: its character
    # class admits no slash, and every path here has one after /6502/.
    #
    # This location deliberately declares no add_header (the service sets its
    # own CORS, and one add_header here would discard all five above).
    location = /6502/api {
        proxy_hide_header Cache-Control;
        proxy_pass http://127.0.0.1:6511;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }

    location /6502/api/ {
        proxy_pass http://127.0.0.1:6502/;
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_set_header X-Forwarded-Prefix /6502/api;
    }

    # The API: uvicorn with --root-path /api, so it generates its own URLs
    # under the prefix and openapi.json stays correct behind the proxy.
    #
    # This location deliberately declares no add_header. Adding one would
    # discard all five above.
    location /api/ {
        proxy_pass http://127.0.0.1:6510/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Everything else is Next: / and /docs, plus /_next/static, which the map
    # above marks immutable because those names are content-hashed by the
    # build and their bytes therefore cannot change.
    #
    # No add_header here either, for the same reason as above.
    #
    # proxy_hide_header IS here, and it is a bug fix rather than tidying.
    # add_header adds; it does not replace. Next sends its own Cache-Control
    # (s-maxage=31536000 on a prerendered page), so without this the response
    # carried TWO Cache-Control headers saying different things, and a shared
    # cache is free to resolve "s-maxage=31536000, no-cache" either way.
    # Measured on the live response before and after.
    #
    # Note this is not the add_header trap: proxy_hide_header is a different
    # directive and declaring it here discards no inherited add_header.
    location / {
        proxy_hide_header Cache-Control;
        proxy_pass http://127.0.0.1:6511;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }
}
