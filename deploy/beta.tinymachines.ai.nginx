# beta.tinymachines.ai -- the same tree, a different arrangement.
#
# INSTALLED 2026-09-20. This file is the source of truth; the copy under
# /etc/nginx is a copy. Change it here, then reinstall, `nginx -t`, reload.
#
# What this is for. The site is organised by where things came from (a section
# per repository) rather than by what a visitor came to do, and the map at
# /style/map measured what that costs: four pages nobody links to, twenty-five
# with one door, and eighty of a hundred and forty sitting exactly two clicks
# out. Rearranging that on the live site means moving paths people have, so it
# happens here first, and arrives there as additions plus redirects.
#
# The rule that makes this safe: ONE COPY OF EVERY FACT. This origin serves a
# build of the same repository from the `beta` branch. No document, figure or
# translation is copied here. What differs is structure: routes, hubs, the
# front page, the order of things. If a page's prose needs changing, it
# changes on the branch and lands on the live site by merge, never by being
# written twice.
#
# One process behind it, on loopback, built from a worktree of that branch:
#   127.0.0.1:6541  Next 16, the whole site
#
# The API is NOT duplicated. /api here proxies to the same uvicorn the live
# site uses (127.0.0.1:6510), because the API is a published contract and a
# second copy of it would be a second thing to keep true. The beta is about
# arrangement, not about the machine underneath.
#
# Nothing here may be indexed, and it is enforced in three places rather than
# one: X-Robots-Tag on every response, a robots.txt served from this file, and
# the build's own noindex (TM_BETA=1). The site's canonical links still point
# at tinymachines.ai, so even a crawler that ignored all three would be told
# where the real page is.

server {
    listen 80;
    listen [::]:80;
    server_name beta.tinymachines.ai;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name beta.tinymachines.ai;

    ssl_certificate     /etc/letsencrypt/live/beta.tinymachines.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/beta.tinymachines.ai/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/beta.tinymachines.ai.access.log;
    error_log  /var/log/nginx/beta.tinymachines.ai.error.log;

    # Every header the origin sets is declared once, here, for the same reason
    # the apex does it: one add_header inside a location discards every
    # inherited one, and the 6502 vhost lost its CSP that way once.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # No HSTS on purpose: this host is temporary, and pinning a browser to
    # HTTPS for a name that may stop existing is a promise about the future.

    # Served from here rather than from the build, so it cannot be forgotten
    # when the branch is rebuilt.
    location = /robots.txt {
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Content-Type "text/plain" always;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location /.well-known/acme-challenge/ { root /var/www/html; }

    # The API is the live one. A beta of the arrangement is not a beta of the
    # contract, and two uvicorns answering the same routes is two things to
    # keep true.
    location /api/ {
        proxy_pass http://127.0.0.1:6510/;
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }

    # The reference page, and the service under it. The exact match is what
    # keeps the page: a proxied prefix location makes nginx answer the
    # slash-less form with an automatic 301 onto the prefix, so without this
    # /6502/api landed on the service's own page instead of this site's
    # reference. Measured here on 2026-09-21, the same way the apex measured
    # it: the e2e suite reported no language flag on the page, because the
    # page it got was not the page.
    #
    # This location deliberately declares no add_header (one here would
    # discard the three above).
    location = /6502/api {
        proxy_hide_header Cache-Control;
        proxy_pass http://127.0.0.1:6541;
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }

    location /6502/api/ {
        proxy_pass http://127.0.0.1:6502/;
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_set_header X-Forwarded-Prefix /6502/api;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }

    # ---------------------------------------------------------------------
    # The chip's own files, from where they already live.
    #
    # Copied from the apex vhost, which explains at length why these are an
    # alias and not a copy: the explorer's data is die geometry and the
    # tables built from it, all CC BY-NC-SA 3.0, and one publisher serving
    # one set of bytes at a second address it also owns is not redistribution.
    # That reasoning applies here unchanged, and this origin is one more
    # address the same publisher owns.
    #
    # Without these, every instrument on this host boots with nothing to run.
    # It looked like a working page: the shell renders, the prose renders, and
    # only the thing the page is for is missing. The e2e suite is what noticed,
    # on 2026-09-21, and only because its kit check refuses to run on a page
    # with too few elements to measure. Ten tool pages, failing identically,
    # while the same pages passed on the live site.
    #
    # ^~ so this prefix wins over the regex below, which would otherwise
    # swallow chip/pkg/ as path segments and alias the wasm without its pkg/.
    location ^~ /6502/chip/ {
        alias /var/www/6502.tinymachines.ai/current/;
        gzip_static on;
    }

    # The data files at the paths the explorer's own code asks for, which are
    # document-relative: from /6502/tracer it fetches schematic.<hash>.json,
    # from /6502/tracer/article one segment deeper, and from /ja/6502/tracer
    # one deeper again. Same files, every address they answer at. Narrow on
    # purpose: only these extensions, no slash in the asset name, and neither
    # pkg/ nor api/ taken as a path segment, so it cannot shadow the service
    # above or a page like /6502/games.
    location ~ "^/(?:ja/)?6502/(?:(?!pkg/|api/)[a-z0-9-]+/)*(?<chipasset>(?:pkg/)?[A-Za-z0-9._-]+\.(?:bin|json|wasm|window))$" {
        alias /var/www/6502.tinymachines.ai/current/$chipasset;
    }

    # The visual6502 archive: somebody else's site, preserved. The overview is
    # ours and is a page here; everything under it comes off disk, with its
    # absolute navigation rewritten on the way out rather than in the files.
    # gzip_static off because sub_filter cannot rewrite a response nginx did
    # not build, and a precompressed .gz is handed back untouched.
    location = /6502/archive/ {
        return 301 /6502/archive;
    }

    location /6502/archive/ {
        alias /var/www/6502.tinymachines.ai/archive/;
        gzip_static off;
        sub_filter_once off;
        sub_filter 'href="/programs"'  'href="/6502/programs"';
        sub_filter 'href="/primer"'    'href="/6502/primer"';
        sub_filter 'href="/trace"'     'href="/6502/trace"';
        sub_filter 'href="/schematic"' 'href="/6502/schematic"';
        sub_filter 'class="nav-cta" href="/"' 'class="nav-cta" href="/6502/explorer"';
    }

    location / {
        proxy_pass http://127.0.0.1:6541;
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }
}
