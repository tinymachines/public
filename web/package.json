{
  "name": "tinymachines-web",
  "version": "1.0.110",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 6511",
    "build": "python3 ../style/build-icon.py && bun scripts/build-sw.mjs && bun scripts/pull-console.mjs && bun scripts/build-lab.mjs && bun scripts/pull-chipdocs.mjs && next build && bun scripts/check-build.mjs",
    "start": "next start -H 127.0.0.1 -p 6511",
    "lint": "eslint",
    "check": "bun scripts/check-build.mjs",
    "test": "bun scripts/pull-console.mjs && bun test lib",
    "icons": "python3 ../style/build-icon.py",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "gray-matter": "^4.0.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
